{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(task lint *)",
      "Bash(curl *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "task lint",
            "timeout": 300,
            "statusMessage": "Lint the whole project"
          },
          {
            "type": "command",
            "command": "task inspec:check",
            "timeout": 120,
            "statusMessage": "Validate InSpec profiles"
          }
        ]
      }
    ]
  }
}
